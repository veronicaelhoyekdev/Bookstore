# Set these variables in the application's process environment before starting.
# Spring Boot does not automatically load .env files.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
JWT_SECRET_KEY=<replace-with-your-own-generated-secret>

# Optional: defaults are bookstore and 86400000 milliseconds (24 hours).
MONGODB_DATABASE=bookstore
JWT_EXPIRATION=86400000
